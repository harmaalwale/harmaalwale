# ─── HarmaalWale Deploy Config ───────────────────────────────
# Copy to .env — NEVER commit .env to git

# ── GitHub ─────────────────────────────────────────────────────
GIT_BRANCH=main

# ── cPanel SSH credentials ─────────────────────────────────────
# Found in: cPanel → SSH Access
SSH_HOST=harmaalwale.com
SSH_USER=your_cpanel_username
SSH_PORT=22
SSH_REMOTE_PATH=/home/your_cpanel_username/public_html
SSH_KEY=~/.ssh/harmaalwale_deploy    # path to your private key
