# HarmaalWale — Git line ending config
# Fixes CRLF warnings on Windows

* text=auto eol=lf

# Force LF for all code files
*.sh    text eol=lf
*.php   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
*.txt   text eol=lf
*.xml   text eol=lf
*.svg   text eol=lf
*.conf  text eol=lf
.htaccess text eol=lf
.gitignore text eol=lf
.env*   text eol=lf

# Binary — never touch line endings
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.zip   binary
*.7z    binary
